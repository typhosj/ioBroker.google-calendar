{
    "cli": true,
    "target": "directory",
    "adapterName": "google-calendar",
    "title": "Google Calendar",
    "description": "Reads Google Calendar events with a service account and provides them for visualisations",
    "keywords": ["calendar", "google", "appointments", "birthdays", "reminders"],
    "contributors": [],
    "expert": "yes",
    "features": ["adapter"],
    "adminFeatures": [],
    "type": "date-and-time",
    "startMode": "daemon",
    "connectionType": "cloud",
    "dataSource": "poll",
    "connectionIndicator": "yes",
    "adapterSettings": [
        {
            "key": "pollMinutes",
            "defaultValue": 5,
            "inputType": "number",
            "label": "Poll interval (min)"
        },
        {
            "key": "daysPast",
            "defaultValue": 30,
            "inputType": "number",
            "label": "Days in the past"
        },
        {
            "key": "daysPreview",
            "defaultValue": 150,
            "inputType": "number",
            "label": "Days ahead"
        }
    ],
    "language": "TypeScript",
    "nodeVersion": "22",
    "adminUi": "json",
    "tools": ["ESLint", "type checking", "Prettier"],
    "eslintConfig": "official",
    "i18n": "JSON",
    "releaseScript": "yes",
    "devServer": "no",
    "indentation": "Space (4)",
    "quotes": "single",
    "authorName": "typhosj",
    "authorGithub": "typhosj",
    "authorEmail": "typhosj@gmx.de",
    "gitRemoteProtocol": "HTTPS",
    "gitCommit": "no",
    "defaultBranch": "main",
    "license": "MIT License",
    "dependabot": "yes",
    "creatorVersion": "3.1.5"
}
